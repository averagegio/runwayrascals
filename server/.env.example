# Copy to .env and fill in real values for production
PORT=8787
JWT_SECRET=change-me-runway-rascals-dev-secret

# Neon Postgres (required for production). Leave empty to use local JSON files.
DATABASE_URL=

# Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: shared Payment Link fallback if Checkout Sessions are not used
STRIPE_PAYMENT_LINK=

# Frontend origin for CORS + default Stripe redirect URLs
CLIENT_ORIGIN=http://127.0.0.1:8765
